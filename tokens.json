{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "IntegraSystem",
    "version": "1.1.0",
    "status": "final",
    "description": "Enterprise B2B brand tokens — system integrator, server & infrastructure"
  },
  "color": {
    "primary": {
      "integra-blue": {
        "$value": "#0052CC",
        "$type": "color",
        "usage": ["logo-light", "buttons", "links", "main-accents"]
      },
      "integra-blue-hover": {
        "$value": "#0045AD",
        "$type": "color",
        "usage": ["button-hover"]
      },
      "integra-blue-light": {
        "$value": "#3B82F6",
        "$type": "color",
        "usage": ["logo-system-dark", "accents-on-dark-background"]
      },
      "integra-cyan": {
        "$value": "#00B4D8",
        "$type": "color",
        "usage": ["bullets", "separators", "hover", "small-decorative-ui"]
      }
    },
    "neutral": {
      "graphite": {
        "$value": "#2D3748",
        "$type": "color",
        "usage": ["headings", "logo-integra-light"]
      },
      "dark-gray": {
        "$value": "#4A5568",
        "$type": "color",
        "usage": ["body-text"]
      },
      "medium-gray": {
        "$value": "#68737A",
        "$type": "color",
        "usage": ["secondary-text"]
      },
      "border-gray": {
        "$value": "#E5E7EB",
        "$type": "color",
        "usage": ["borders"]
      },
      "light-gray": {
        "$value": "#F8FAFC",
        "$type": "color",
        "usage": ["blocks", "surfaces"]
      },
      "white": {
        "$value": "#FFFFFF",
        "$type": "color",
        "usage": ["background", "logo-integra-dark", "logo-mark-dark"]
      }
    },
    "dark": {
      "deep-black": {
        "$value": "#111827",
        "$type": "color",
        "usage": ["dark-background", "business-card-front"]
      },
      "dark-surface": {
        "$value": "#1F2937",
        "$type": "color",
        "usage": ["dark-surface"]
      },
      "dark-border": {
        "$value": "#374151",
        "$type": "color",
        "usage": ["dark-borders"]
      },
      "dark-text": {
        "$value": "#E5E7EB",
        "$type": "color",
        "usage": ["dark-theme-text"]
      }
    },
    "brand-formula": [
      "#0052CC",
      "#3B82F6",
      "#2D3748",
      "#FFFFFF",
      "#111827",
      "#00B4D8"
    ]
  },
  "typography": {
    "fontFamily": {
      "primary": {
        "$value": "Inter",
        "$type": "fontFamily"
      },
      "alternatives": {
        "$value": ["Montserrat", "Manrope"],
        "$type": "fontFamily"
      }
    },
    "fontSize": {
      "h1": { "$value": "56px", "$type": "dimension" },
      "h2": { "$value": "40px", "$type": "dimension" },
      "h3": { "$value": "32px", "$type": "dimension" },
      "h4": { "$value": "24px", "$type": "dimension" },
      "body": { "$value": "18px", "$type": "dimension" },
      "small": { "$value": "14px", "$type": "dimension" }
    },
    "fontWeight": {
      "regular": { "$value": 400, "$type": "number" },
      "medium": { "$value": 500, "$type": "number" },
      "semibold": { "$value": 600, "$type": "number" },
      "bold": { "$value": 700, "$type": "number" },
      "extrabold": { "$value": 800, "$type": "number" }
    }
  },
  "spacing": {
    "1": { "$value": "8px", "$type": "dimension" },
    "2": { "$value": "16px", "$type": "dimension" },
    "3": { "$value": "24px", "$type": "dimension" },
    "4": { "$value": "32px", "$type": "dimension" },
    "5": { "$value": "48px", "$type": "dimension" },
    "6": { "$value": "64px", "$type": "dimension" },
    "7": { "$value": "96px", "$type": "dimension" }
  },
  "layout": {
    "maxWidth": { "$value": "1280px", "$type": "dimension" },
    "gridColumns": { "$value": 12, "$type": "number" }
  },
  "borderRadius": {
    "sm": { "$value": "6px", "$type": "dimension" },
    "default": { "$value": "10px", "$type": "dimension" },
    "md": { "$value": "12px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" }
  },
  "button": {
    "primary": {
      "background": { "$value": "#0052CC", "$type": "color" },
      "backgroundHover": { "$value": "#0045AD", "$type": "color" },
      "color": { "$value": "#FFFFFF", "$type": "color" },
      "borderRadius": { "$value": "10px", "$type": "dimension" }
    },
    "secondary": {
      "background": { "$value": "transparent", "$type": "color" },
      "border": { "$value": "1px solid #0052CC", "$type": "string" },
      "color": { "$value": "#0052CC", "$type": "color" }
    }
  },
  "logo": {
    "light": {
      "mark": { "$value": "#0052CC", "$type": "color" },
      "integra": { "$value": "#2D3748", "$type": "color" },
      "system": { "$value": "#0052CC", "$type": "color" }
    },
    "dark": {
      "mark": { "$value": "#FFFFFF", "$type": "color" },
      "integra": { "$value": "#FFFFFF", "$type": "color" },
      "system": { "$value": "#3B82F6", "$type": "color" }
    }
  },
  "icon": {
    "style": "outline",
    "strokeWidth": { "$value": "1.5", "$type": "dimension" },
    "color": { "$value": "#0052CC", "$type": "color" }
  }
}
